// Prisma schema for Multi-Vendor ERP + E-Commerce + POS + Inventory + Warehouse

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================== ENUMS ===================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  DRAFT
  PENDING
  REVIEWING
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  RAZORPAY
  STRIPE
  COD
}

model ProductType {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum BarcodeStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RESTOCKED
  DAMAGED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  RETURN_RESTOCK
  RETURN_DAMAGE
}

enum TickerType {
  INFO
  WARNING
  SUCCESS
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SupplierTxnType {
  PURCHASE
  PAYMENT
  ADJUSTMENT
}

// =================== ROLES & RBAC ===================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions              RolePermission[]
  users                    UserRole[]
  upgradeRequestsCurrent   RoleUpgradeRequest[] @relation("CurrentRole")
  upgradeRequestsRequested RoleUpgradeRequest[] @relation("RequestedRole")
  rolePrices               RolePrice[]
  commissionConfig         CommissionConfig?
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// =================== USERS ===================

model User {
  id             String     @id @default(cuid())
  name           String
  mobile         String?    @unique
  email          String     @unique
  passwordHash   String
  gstNumber      String?
  businessName   String?
  stateCode      String?
  address        String?
  customerTypeId String?
  status         UserStatus @default(ACTIVE)
  emailVerified  Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  roles                  UserRole[]
  roleUpgradeRequests    RoleUpgradeRequest[]
  carts                  Cart[]
  orders                 Order[]
  payments               Payment[]
  posSales               PosSale[]
  auditLogs              AuditLog[]
  otps                   OtpToken[]
  passwordResets         PasswordReset[]
  ticketsCreated         Ticket[]             @relation("TicketCreator")
  ticketsAssigned        Ticket[]             @relation("TicketAssignee")
  ticketReplies          TicketReply[]
  ticketMessages         TicketMessage[]
  purchaseOrdersCreated  PurchaseOrder[]      @relation("POCreator")
  purchaseOrdersApproved PurchaseOrder[]      @relation("POApprover")
  ordersReviewed         Order[]              @relation("OrderReviewer")
  commissionsEarned      SalesCommission[]
  loginAsAdmin           LoginAsUser[]        @relation("AdminImpersonator")
  loginAsTarget          LoginAsUser[]        @relation("ImpersonatedUser")
  salesPerson            SalesPerson?
  vendor                 Vendor?
  customerType           CustomerType?        @relation(fields: [customerTypeId], references: [id])
  commissionWallet       CommissionWallet?
  Notification           Notification[]
  ActivityLog            ActivityLog[]
  Store                  Store[]
  GSTFiling              GSTFiling[]
  addresses              Address[]

  @@index([email])
  @@index([mobile])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoleUpgradeRequest {
  id              String        @id @default(cuid())
  userId          String
  currentRoleId   String
  requestedRoleId String
  status          RequestStatus @default(PENDING)
  reason          String?
  adminNote       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole   Role @relation("CurrentRole", fields: [currentRoleId], references: [id])
  requestedRole Role @relation("RequestedRole", fields: [requestedRoleId], references: [id])
}

// =================== CATALOG ===================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  sortOrder   Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryTree")
  products       Product[]
  subProducts    Product[]       @relation("SubCategory")
  vendorProducts VendorProduct[]

  @@index([parentId])
}

model Brand {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logo            String?
  description     String?
  defaultDiscount Decimal  @default(0) @db.Decimal(5, 2)
  status          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?
  productTypeId   String?
  status          ProductStatus @default(ACTIVE)
  customerTypeId  String?
  categoryId      String?
  subCategoryId   String?
  brandId         String?
  unit            String?
  measurement     String?
  gstRate         Decimal       @default(0) @db.Decimal(5, 2)
  hsnCode         String?
  image           String?
  images          String[]      @default([])
  barcode         String?       @unique
  purchasePrice   Decimal       @default(0) @db.Decimal(12, 2)
  mrp             Decimal       @default(0) @db.Decimal(12, 2)
  preGst          Decimal       @default(0) @db.Decimal(12, 2)
  dealerPrice     Decimal       @default(0) @db.Decimal(12, 2)
  wholesalerPrice Decimal       @default(0) @db.Decimal(12, 2)
  parlourPrice    Decimal       @default(0) @db.Decimal(12, 2)
  retailPrice     Decimal       @default(0) @db.Decimal(12, 2)
  onlinePrice     Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal       @default(0) @db.Decimal(5, 2)
  variantType     String?
  minOrderQty     Int           @default(1)
  maxOrderQty     Int           @default(0)
  initialStock    Int           @default(0)
  customSku       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customerType    CustomerType?       @relation(fields: [customerTypeId], references: [id])
  productType     ProductType?        @relation(fields: [productTypeId], references: [id])
  category        Category?           @relation(fields: [categoryId], references: [id])
  subCategory     Category?           @relation("SubCategory", fields: [subCategoryId], references: [id])
  brand           Brand?              @relation(fields: [brandId], references: [id])
  variants        ProductVariant[]
  rolePrices      RolePrice[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  inventory       Inventory[]
  barcodes        Barcode[]
  visibility      ProductVisibility[]
  purchaseItems   PurchaseOrderItem[]
  ProductImage    ProductImage[]

  @@index([categoryId])
  @@index([brandId])
  @@index([customerTypeId])
  @@index([subCategoryId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique
  barcode    String?  @unique
  name       String
  attributes Json?
  mrp        Decimal  @db.Decimal(12, 2)
  price      Decimal  @db.Decimal(12, 2)
  weight     Decimal? @db.Decimal(10, 3)
  image      String?
  status     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     Inventory[]
  barcodes      Barcode[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  purchaseItems PurchaseOrderItem[]

  @@index([productId])
}

model RolePrice {
  id               String   @id @default(cuid())
  productId        String
  roleId           String
  price            Decimal  @db.Decimal(12, 2)
  mrp              Decimal  @db.Decimal(12, 2)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  minQty           Int      @default(1)
  commissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  visible          Boolean  @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([productId, roleId])
}

// =================== SUPPLIERS ===================

model Supplier {
  id                String   @id @default(cuid())
  code              String?  @unique
  companyName       String
  contactName       String?
  gstin             String?
  email             String?
  phone             String?
  phone2            String?
  
  // Address
  address           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  country           String?
  pincode           String?

  // Bank Details
  bankName          String?
  bankAccount       String?
  ifsc              String?
  accountHolderName String?

  // Settings
  creditDays        Int      @default(0)
  openingBalance    Decimal  @default(0) @db.Decimal(14, 2)
  balanceType       String   @default("CREDIT")

  // Pricing Margins
  dealerMargin      Decimal  @default(0) @db.Decimal(5, 2)
  wholesalerMargin  Decimal  @default(0) @db.Decimal(5, 2)
  retailMargin      Decimal  @default(0) @db.Decimal(5, 2)
  parlourMargin     Decimal  @default(0) @db.Decimal(5, 2)
  onlineMargin      Decimal  @default(0) @db.Decimal(5, 2)

  status            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions   SupplierTransaction[]
  purchaseOrders PurchaseOrder[]
}

model SupplierTransaction {
  id         String          @id @default(cuid())
  supplierId String
  type       SupplierTxnType
  amount     Decimal         @db.Decimal(14, 2)
  reference  String?
  note       String?
  date       DateTime        @default(now())
  createdAt  DateTime        @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// =================== WAREHOUSES & INVENTORY ===================

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  pincode   String?
  managerId String?
  capacity  Int?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory          Inventory[]
  transfersOut       WarehouseTransfer[] @relation("SourceWarehouse")
  transfersIn        WarehouseTransfer[] @relation("DestinationWarehouse")
  inventoryMovements InventoryMovement[]
  barcodes           Barcode[]
  purchaseOrders     PurchaseOrder[]
  Store              Store[]
}

model Inventory {
  id           String   @id @default(cuid())
  productId    String
  variantId    String?
  warehouseId  String
  batchNumber  String?
  quantity     Int      @default(0)
  reorderLevel Int      @default(5)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, warehouseId, batchNumber])
  @@index([warehouseId])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  productId       String
  variantId       String?
  warehouseId     String
  type            InventoryMovementType
  quantity        Int
  reference       String?
  purchaseOrderId String?
  note            String?
  createdAt       DateTime              @default(now())

  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([productId])
  @@index([warehouseId])
}

model WarehouseTransfer {
  id                     String         @id @default(cuid())
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 TransferStatus @default(DRAFT)
  note                   String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  completedAt            DateTime?

  source      Warehouse               @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destination Warehouse               @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  items       WarehouseTransferItem[]
}

model WarehouseTransferItem {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  variantId  String?
  quantity   Int

  transfer WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model Barcode {
  id          String        @id @default(cuid())
  code        String        @unique
  productId   String
  variantId   String?
  warehouseId String
  status      BarcodeStatus @default(IN_STOCK)
  batchNumber String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([status])
}

// =================== CART & WISHLIST ===================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int     @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// =================== ORDERS ===================

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String
  salesmanId      String?
  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentMethod   PaymentMethod?
  subtotal        Decimal        @db.Decimal(14, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(14, 2)
  shippingTotal   Decimal        @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal        @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal        @db.Decimal(14, 2)
  shippingAddress Json
  billingAddress  Json?
  notes           String?
  reviewNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  reviewedBy    User?                @relation("OrderReviewer", fields: [reviewedById], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  dispatch      Dispatch?
  returns       ReturnRequest[]
  commissions   SalesCommission[]
  Store         Store?               @relation(fields: [storeId], references: [id])
  storeId       String?

  @@index([userId])
  @@index([salesmanId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  sku       String
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(14, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  returns ReturnItem[]
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String?
  userId        String?
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(14, 2)
  transactionId String?
  gateway       String?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order? @relation(fields: [orderId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])
}

// =================== DISPATCH ===================

model Dispatch {
  id          String    @id @default(cuid())
  orderId     String    @unique
  warehouseId String
  status      String    @default("PENDING")
  note        String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items DispatchItem[]
}

model DispatchItem {
  id          String  @id @default(cuid())
  dispatchId  String
  orderItemId String
  barcodeId   String
  scanned     Boolean @default(false)

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
}

// =================== RETURNS ===================

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  userId    String
  reason    String?
  status    ReturnStatus @default(REQUESTED)
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnItem[]
}

model ReturnItem {
  id          String  @id @default(cuid())
  returnId    String
  orderItemId String
  barcodeId   String?
  condition   String?
  action      String?

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
}

// =================== POS ===================

model PosSession {
  id          String    @id @default(cuid())
  userId      String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal   @default(0) @db.Decimal(12, 2)
  closingCash Decimal?  @db.Decimal(12, 2)
  note        String?
}

model PosSale {
  id            String        @id @default(cuid())
  sessionId     String?
  cashierId     String
  customerName  String?
  customerPhone String?
  invoiceNo     String        @unique
  subtotal      Decimal       @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PAID)
  createdAt     DateTime      @default(now())

  cashier User          @relation(fields: [cashierId], references: [id])
  items   PosSaleItem[]
}

model PosSaleItem {
  id        String  @id @default(cuid())
  posSaleId String
  productId String
  variantId String?
  barcode   String?
  name      String
  sku       String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(14, 2)

  posSale PosSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
}

// =================== MARKETING ===================

model Slider {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  image      String
  buttonText String?
  url        String?
  sortOrder  Int      @default(0)
  status     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TickerMessage {
  id        String     @id @default(cuid())
  message   String
  type      TickerType @default(INFO)
  link      String?
  status    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// =================== SYSTEM ===================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// =================== SUPPORT TICKETS ===================

model Ticket {
  id           String         @id @default(cuid())
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  createdById  String
  assignedToId String?
  entityType   String?
  entityId     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy  User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  replies    TicketReply[]
  messages   TicketMessage[]

  @@index([status])
  @@index([createdById])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

// =================== PURCHASE ORDERS ===================

model PurchaseOrder {
  id                    String              @id @default(cuid())
  poNumber              String              @unique
  supplierId            String
  warehouseId           String
  status                PurchaseOrderStatus @default(DRAFT)
  expectedDate          DateTime?
  supplierInvoiceNumber String?
  supplierInvoiceDate   DateTime?
  invoiceFile           String?
  
  subtotal              Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal             @default(0) @db.Decimal(14, 2)
  transportCost         Decimal             @default(0) @db.Decimal(14, 2)
  extraMargin           Decimal             @default(0) @db.Decimal(14, 2)
  marginType            String?             @default("PERCENTAGE") // PERCENTAGE or FIXED
  grandTotal            Decimal             @default(0) @db.Decimal(14, 2)
  payableAmount         Decimal             @default(0) @db.Decimal(14, 2)
  
  notes                 String?
  createdById           String
  approvedById          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  receivedAt            DateTime?

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  warehouse  Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy  User                @relation("POCreator", fields: [createdById], references: [id])
  approvedBy User?               @relation("POApprover", fields: [approvedById], references: [id])
  items      PurchaseOrderItem[]
  movements  InventoryMovement[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id                        String  @id @default(cuid())
  purchaseOrderId           String
  productId                 String
  variantId                 String?
  barcode                   String?
  
  quantity                  Int     // Keeping this for backwards compatibility, acts as actualQty in new flow
  actualQty                 Int     @default(0)
  billedQty                 Int     @default(0)
  packSize                  Int     @default(1)
  receivedQty               Int     @default(0)
  
  unitCost                  Decimal @db.Decimal(12, 2) // Keeping for compatibility, acts as preGstRate
  preGstRate                Decimal @default(0) @db.Decimal(12, 2)
  preGstAmount              Decimal @default(0) @db.Decimal(14, 2)
  
  discountPercent           Decimal @default(0) @db.Decimal(5, 2)
  additionalDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  
  gstPercent                Decimal @default(0) @db.Decimal(5, 2)
  gstAmount                 Decimal @default(0) @db.Decimal(14, 2)
  
  transportCost             Decimal @default(0) @db.Decimal(14, 2)
  
  lineTotal                 Decimal @db.Decimal(14, 2) // Keeping for compatibility, acts as finalAmount
  finalAmount               Decimal @default(0) @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
}

// =================== COMMISSIONS ===================

model SalesCommission {
  id         String           @id @default(cuid())
  salesmanId String
  orderId    String
  amount     Decimal          @db.Decimal(14, 2)
  percentage Decimal          @default(0) @db.Decimal(5, 2)
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  salesman User  @relation(fields: [salesmanId], references: [id])
  order    Order @relation(fields: [orderId], references: [id])

  @@index([salesmanId])
  @@index([orderId])
  @@index([status])
}

model CommissionConfig {
  id          String   @id @default(cuid())
  roleId      String
  percentage  Decimal  @db.Decimal(5, 2)
  minOrderAmt Decimal  @default(0) @db.Decimal(12, 2)
  maxOrderAmt Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId])
}

// =================== VENDOR MARKETPLACE ===================

model Vendor {
  id             String       @id @default(cuid())
  userId         String       @unique
  companyName    String
  gstin          String?
  description    String?
  logo           String?
  status         VendorStatus @default(PENDING)
  commissionRate Decimal      @default(0) @db.Decimal(5, 2)
  bankName       String?
  bankAccount    String?
  ifsc           String?
  rejectedReason String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  products VendorProduct[]
  orders   VendorOrder[]

  @@index([status])
}

model VendorProduct {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  slug        String   @unique
  description String?
  categoryId  String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category?              @relation(fields: [categoryId], references: [id])
  variants VendorProductVariant[]

  @@index([vendorId])
}

model VendorProductVariant {
  id              String   @id @default(cuid())
  vendorProductId String
  sku             String   @unique
  name            String
  price           Decimal  @db.Decimal(12, 2)
  mrp             Decimal  @db.Decimal(12, 2)
  stock           Int      @default(0)
  image           String?
  status          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProduct VendorProduct @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@index([vendorProductId])
}

model VendorOrder {
  id              String        @id @default(cuid())
  vendorId        String
  orderNumber     String        @unique
  customerName    String?
  customerPhone   String?
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(14, 2)
  commissionTotal Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal       @default(0) @db.Decimal(14, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vendor Vendor            @relation(fields: [vendorId], references: [id])
  items  VendorOrderItem[]

  @@index([vendorId])
  @@index([status])
}

model VendorOrderItem {
  id            String  @id @default(cuid())
  vendorOrderId String
  productName   String
  sku           String
  quantity      Int
  unitPrice     Decimal @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(14, 2)

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
}

// =================== CUSTOMER TYPE ===================

model CustomerType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  visibility ProductVisibility[]
  products   Product[]
}

// =================== LOGIN-AS-USER ===================

model LoginAsUser {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String
  reason       String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  admin      User @relation("AdminImpersonator", fields: [adminId], references: [id])
  targetUser User @relation("ImpersonatedUser", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
}

// =================== STOCK ALERTS ===================

model StockAlert {
  id           String   @id @default(cuid())
  productId    String
  variantId    String?
  warehouseId  String
  currentQty   Int
  reorderLevel Int
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([isRead])
}

// =================== PRODUCT VISIBILITY ===================

model ProductVisibility {
  id             String  @id @default(cuid())
  productId      String
  customerTypeId String
  isVisible      Boolean @default(true)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerType CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Cascade)

  @@unique([productId, customerTypeId])
}

// =================== SALES PERSON MANAGEMENT ===================

model SalesPerson {
  id            String   @id @default(cuid())
  userId        String   @unique
  employeeCode  String?  @unique
  assignedArea  String?
  targetAmount  Decimal? @db.Decimal(14, 2)
  commissionPct Decimal  @default(0) @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// =================== COMMISSION WALLET ===================

model CommissionWallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  totalEarned    Decimal  @default(0) @db.Decimal(14, 2)
  totalWithdrawn Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                          @relation(fields: [userId], references: [id])
  transactions CommissionWalletTransaction[]

  @@index([userId])
}

model CommissionWalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String // CREDIT, DEBIT, WITHDRAWAL
  amount      Decimal  @db.Decimal(14, 2)
  reference   String? // orderId, commissionId, etc.
  description String?
  createdAt   DateTime @default(now())

  wallet CommissionWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

// =================== NOTIFICATIONS ===================

enum NotificationType {
  ORDER_UPDATE
  STOCK_ALERT
  COMMISSION
  SYSTEM
  VENDOR
  CUSTOM
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  title      String
  body       String
  type       NotificationType @default(SYSTEM)
  entityType String?
  entityId   String?
  read       Boolean          @default(false)
  data       Json?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// =================== ACTIVITY TRACKING ===================

enum ActivityType {
  LOGIN
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  STATUS_CHANGE
  EXPORT
  IMPORT
}

model ActivityLog {
  id          String       @id @default(cuid())
  userId      String?
  type        ActivityType
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// =================== MULTI-STORE ===================

enum StoreStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Store {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  type        String      @default("PHYSICAL")
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  managerId   String?
  warehouseId String?
  status      StoreStatus @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  manager   User?      @relation(fields: [managerId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  orders    Order[]
}

// =================== PRODUCT IMAGES ===================

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// =================== TAX MANAGEMENT ===================

enum TaxType {
  GST
  IGST
  CGST_SGST
  EXEMPTED
}

model TaxRule {
  id           String   @id @default(cuid())
  name         String
  rate         Decimal  @db.Decimal(5, 2)
  type         TaxType  @default(GST)
  hsnCode      String?
  stateCode    String?
  minAmount    Decimal? @db.Decimal(12, 2)
  maxAmount    Decimal? @db.Decimal(12, 2)
  applicableTo String?
  targetId     String?
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
}

// =================== GST MANAGEMENT ===================

enum GSTFilingStatus {
  DRAFT
  FILED
  VERIFIED
  REJECTED
}

model GSTFiling {
  id          String          @id @default(cuid())
  period      String
  filingType  String
  status      GSTFilingStatus @default(DRAFT)
  totalSales  Decimal         @default(0) @db.Decimal(14, 2)
  totalTax    Decimal         @default(0) @db.Decimal(14, 2)
  itcAmount   Decimal         @default(0) @db.Decimal(14, 2)
  liability   Decimal         @default(0) @db.Decimal(14, 2)
  data        Json?
  filedAt     DateTime?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([period, filingType])
}

// =================== MESSAGE TEMPLATES ===================

enum TemplateType {
  EMAIL
  SMS
  WHATSAPP
}

model MessageTemplate {
  id        String       @id @default(cuid())
  name      String
  type      TemplateType
  subject   String?
  body      String
  variables Json?
  status    Boolean      @default(true)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([name, type])
}

// =================== SETTINGS ===================

model Setting {
  id        String   @id @default(cuid())
  group     String
  key       String   @unique
  value     Json
  type      String   @default("string")
  label     String?
  options   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

